# ─── signals-dpg local-setup — environment (Track A / Docker-only) ──────────
# Copy to .env in THIS directory (signals-dpg/local-setup/) and adjust if needed.
# `docker compose` here reads this file. Working dev defaults are pre-filled —
# regenerate the secrets before using on any shared host.
#
# (Track B / hybrid runs from the repo root using signals-dpg's own root
# .env.example — see LOCAL_SETUP.md §6.)

# ── Instance / network
INSTANCE_NAME=signals-local
# Which network config under examples/schemas/<network>/network.json to load,
# and the domains this instance serves.
SIGNALS_NETWORK=blue_dot
SERVED_DOMAINS=blue_dot/seeker,blue_dot/provider

# ── Secrets (CHANGE for any shared host) ────────────────────────────────────
# Auth signing secret.
AUTH_SECRET=dev-auth-secret-change-me
# PII encryption key — MUST be base64 that decodes to exactly 32 bytes.
# Generate a fresh one with: openssl rand -base64 32
SIGNALS_PII_KEY=CHANGE_ME_RUN_openssl_rand_base64_32

# ── API / UI ports (host)
API_PORT=2742
# Signals UI is fixed to host :5173 (API CORS allow-list is 3000/5173/2742).

# ── Postgres (host port + creds; the compose builds a pgvector+postgis image)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev-postgres-password-change-me
POSTGRES_DB=postgresdb
DATABASE_PORT=5432

# ── Redis (password-protected; host port 5555 → container 6379)
REDIS_PASSWORD=dev-redis-password-change-me
REDIS_PORT=5555

# ── Keycloak (OPT-IN — better-auth → Keycloak migration) ────────────────────
# Nothing below is read until BOTH of these are true:
#   1. AUTH_PROVIDER is moved off 'betterauth', and
#   2. the optional Keycloak services are started:
#        docker compose --profile keycloak up -d
# The default `docker compose up -d` ignores every value in this section.

# API-side provider flag:
#   betterauth  today's behaviour; every Keycloak path stays dormant
#   dual        Keycloak tokens accepted alongside better-auth sessions
#   keycloak    Keycloak only
AUTH_PROVIDER=betterauth

  # Browser-facing Keycloak base URL. The API derives the expected `iss` from this
  # plus the realm, so it must match what Keycloak actually mints. (The API's
  # server-to-server URL is hardcoded to http://keycloak:8080 in the compose.)
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_PORT=8080

  # One shared realm per instance, holding both DPGs' clients.
KEYCLOAK_REALM=bluedots

  # Public OIDC client used by the UI login flow.
KEYCLOAK_UI_CLIENT_ID=signals-ui

  # Confidential client secret for signals-api — used for Admin REST calls (the
  # user migration and admin participant creation). Matches the dev placeholder
  # in infra/keycloak/realms/bluedots-realm.json.
KEYCLOAK_API_CLIENT_SECRET=signals-api-dev-secret-change-me

  # Integrating DPGs allowed to use client-credentials service auth, comma
  # separated (e.g. aggregator-dpg,voice-dpg). EMPTY means service auth stays on
  # x-api-key. Each id must equal the organization.slug created by
  # `pnpm db:seed:services`.
KEYCLOAK_SERVICE_CLIENT_IDS=

  # Keycloak admin-console login. Local dev only — this whole stack is plain HTTP
  # on localhost. CHANGE for any shared host.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=dev-keycloak-admin-change-me

  # Browser-facing base URL substituted into the realm's redirectUris, webOrigins
  # and post-logout URIs at container start. Should be the Signals UI origin.
PUBLIC_BASE_URL=http://localhost:5173
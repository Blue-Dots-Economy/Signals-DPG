# package/config/src/secrets.ts manages the calculation for secrets

# Name of the backend service - used by auth layer
INSTANCE_NAME="dpg"

# INSTANCE_ENV:
# set to development for local environment 
# set to production for server environment (domain is linked)
INSTANCE_ENV="development"

# for server environment where a domain is linked to API_PORT enter the domain
API_DOMAIN='http://localhost'
API_PORT="2742"

# Serve the OpenAPI spec + Scalar reference UI at /api/reference. Default on;
# force-disabled when INSTANCE_ENV=production unless API_REFERENCE_FORCE opts
# back in. The always-available reference is the bluedots-docs site.
# Production must set INSTANCE_ENV=production exactly — that's the only
# production signal apiReferenceEnabled checks (see apps/api/src/config.ts) —
# and may additionally set API_REFERENCE_ENABLED=false for defense in depth.
API_REFERENCE_ENABLED=true
# Opt back into serving /api/reference in production.
API_REFERENCE_FORCE=false

# secret for authentication service
AUTH_SECRET="CHANGE_ME_run_openssl_rand_hex_32"
ALLOWED_ORIGINS="https://app.example.com,https://admin.example.com"

# Backend identity on the network.
# Format: network_id/domain_id and comma separate multiple bindings.
SERVED_DOMAINS="blue_dot/seeker,blue_dot/provider"

# Which public host serves which domain, for a split-portal deployment (#569).
# The SAME string the UI ingress uses (helm `ui.hostBindings`): the UI maps
# host -> domain per request from the Host header, the API inverts it to
# domain -> host so an email CTA links the recipient to THEIR OWN portal
# instead of one shared front-door. Supplied by infra from the existing
# `_signals_host_bindings` anchor — there is no second list to maintain.
# Format: host=network/domain, semicolon separated. The host may carry an
# explicit http(s) scheme and port (used for a local split stack); a bare
# hostname gets https://.
# Leave EMPTY for a single-host install or ordinary local dev — every domain
# then falls back to FRONTEND_BASE_URL and behaviour is unchanged.
UI_HOST_BINDINGS=""
# Split-portal example:
# UI_HOST_BINDINGS="providers-signals.example.org=blue_dot/provider;seekers-signals.example.org=blue_dot/seeker"
# Local two-UI example:
# UI_HOST_BINDINGS="http://localhost:5174=blue_dot/seeker;http://localhost:5175=blue_dot/provider"

# Network config source.
# local: load a checked-in JSON file, useful for development
# remote: fetch one or more network config JSON files from NETWORK_CONFIG_URLS
# or derive them from SCHEMA_REGISTRY_URL
NETWORK_CONFIG_SOURCE="local"

# Used when NETWORK_CONFIG_SOURCE=local
NETWORK_CONFIG_LOCAL_FILE="../../examples/schemas/blue_dot/network.json"

# Used when NETWORK_CONFIG_SOURCE=remote
# Format: network_id=url and comma separate multiple mappings
# NETWORK_CONFIG_URLS="onest_yellow_dot=https://registry.example.com/yellow-dot/network.json"

# Skips the boot-time schema-cache warmup DB query when false — used by spec:dump
SCHEMA_CACHE_WARMUP_ENABLED="true"

# Support/grievance email rendered into the consent T&C / Privacy / Grievances
# copy in place of the __SUPPORT_EMAIL__ placeholder the consent.json files ship.
# Optional; defaults to hello@bluedotseconomy.org when unset.
CONSENT_SUPPORT_EMAIL="hello@bluedotseconomy.org"

# Allows extra fields when validating item, action, and event data against runtime JSON Schemas.
ALLOW_EXTRA_SCHEMA_DATA=false

# Maximum number of items accepted in a single bulk request to
# /action/perform and /action/update-status (default 100).
# BULK_MAX_ITEMS=100

# databases

# PostgreSQL configuration
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="CHANGE_ME_POSTGRES_PASSWORD"
POSTGRES_DB="postgresdb"
POSTGRES_HOST="127.0.0.1"
POSTGRES_PORT=5432
DATABASE_PORT=5432
# optional override for external postgres
# POSTGRES_URL="postgres://user:password@host:5432/dbname"

# Redis
REDIS_HOST="127.0.0.1"
REDIS_PASSWORD="CHANGE_ME_REDIS_PASSWORD"
REDIS_PORT=5555
# optional override for external redis
# REDIS_URL="redis://:password@host:6379"

# Notification service configuration to be set when CREATE_TEST_OTP is set to false
# NOTIFICATION_SERVICE_ENDPOINT='enter_notification_service_endpoint'
# NOTIFICATION_SERVICE_KEY_ID='enter_notification_service_key_id'
# NOTIFICATION_SERVICE_SECRET='enter_notification_service_secret'
# SMS_TEMPLATE_ID='enter_sms_template_id'

# ── Match score (profile relevance) ─────────────────────────────────────────
  # Backed by signals-search's in-network relevance API (POST /v1/relevance).
  # Leave MATCH_SCORE_PROVIDER unset to disable match scoring (calculate → 503).
  MATCH_SCORE_PROVIDER=signals_search
  SIGNALS_SEARCH_ENDPOINT=http://localhost:3100
  SIGNALS_SEARCH_API_KEY=              # x-api-key valid in the Signals `apikey` store
  # SIGNALS_SEARCH_RELEVANCE_PATH=     # optional; defaults to v1/relevance

  # UI display gate for the FREE-TEXT / no-profile match score (the /discover
  # relevance badge shown to signed-out viewers when they type a search). Default
  # ON; set false/0/off/no to hide it. The profile-to-profile match score (a
  # signed-in viewer with a profile) is never affected. Runtime-env (per-deploy
  # via Helm config.js). See apps/ui/src/lib/match-score-config.ts.
  # VITE_FREETEXT_MATCH_SCORE_ENABLED=true

# Network schema registry
# Supported formats:
# 1. single base URL, which resolves served networks to {base}/{network}/network.json
# 2. explicit network_id=url mappings for multiple registries or full JSON URLs
# SCHEMA_REGISTRY_URL='https://registry.example.com/schemas/'
# Use Postman from schemas/yellow_dot/postman for the below onest_yellow_dot example.
# NETWORK_CONFIG_LOCAL_FILE="../../examples/schemas/yellow_dot/network.json"
SCHEMA_REGISTRY_URL='onest_yellow_dot=https://registry.example.com/schemas/yellow_dot/network.json,blue_dot=https://registry.other.example.com/schemas/blue_dot/network.json'

# Discover BFF -> signals-search (#203). Optional: when either is unset, the
# discover BFF always falls back to the native (in-repo) search path — the
# API still boots fine without these set.
# SIGNALS_SEARCH_URL='https://signals-search.example.com'
# SIGNALS_SEARCH_API_KEY='enter_signals_search_api_key'
# Optional spatial radius (meters) for /discover; unset -> signals-search's
# ~30km default applies (and DPG still reports 30000 as the effective radius).
# SIGNALS_SEARCH_DISTANCE_METERS=30000

# Feature Flags value: empty to make false || any string to make true
# Test Auth (Unified-Plugin) 
CREATE_TEST_OTP=true
AUTH_MIDDLEWARE_ENABLED=true

# generate with openssl rand -base64 32
SIGNALS_PII_KEY='<replace-me>'

# --- Geocoding (optional) ---
# Server-side geocoding for items created via the API without coordinates.
# If GOOGLE_GEOCODING_API_KEY is unset, Photon (free, OpenStreetMap) is used.
# Key must have the Geocoding API enabled and NOT be HTTP-referrer restricted.
GOOGLE_GEOCODING_API_KEY=
# Optional Photon endpoint override (default: https://photon.komoot.io)
PHOTON_URL=
# Server geocoding cache TTLs (#196, Redis `geo:place:*`). A successful
# place-string -> coordinate resolution is cached this long before re-calling
# the paid geocoding API (places rarely move). Default 2592000 (30 days).
GEO_CACHE_TTL_SECONDS=2592000
# How long an UNRESOLVABLE place string is cached as "not found" — short, so a
# bad string does not hammer the paid API on every retry but is not stuck
# forever. Default 3600 (1 hour).
GEO_CACHE_NEGATIVE_TTL_SECONDS=3600

# A geocode is retried only on a TRANSIENT provider failure (HTTP/network
# error, or a soft rate-limit status like OVER_QUERY_LIMIT) — a definitive
# not-found is never retried. Targets the 429 bursts a large bulk upload can
# trigger. Best-effort one-shot retry, not durable recovery (#405).
# GEO_RETRY_ATTEMPTS is the TOTAL tries (2 = one initial + one retry);
# GEO_RETRY_BACKOFF_MS is the fixed pause between tries. Defaults: 2 / 300.
GEO_RETRY_ATTEMPTS=2
GEO_RETRY_BACKOFF_MS=300

# ─── Frontend (UI / Vite) ───
# ─── Map Configuration ───────────────────────────────────────────
# Map provider: leaflet (default), google-maps, mapbox
VITE_MAP_PROVIDER=leaflet

# Google Maps API key (required when VITE_MAP_PROVIDER=google-maps)
VITE_GOOGLE_MAPS_API_KEY=

# Mapbox access token (required when VITE_MAP_PROVIDER=mapbox)
VITE_MAPBOX_ACCESS_TOKEN=

# ─── API Configuration ────────────────────────────────────────────
# API base URL for authentication and other endpoints
VITE_API_URL=http://localhost:2742

# Additional API instances (dev mode only, JSON format)
# The dropdown will show these options alongside the default
# Example: {"student":"http://localhost:3001","tutor":"http://localhost:3002"}
VITE_API_URLS=

# Override default API URL (optional)
# If set, this will be used instead of VITE_API_URL as the default option
# VITE_DEFAULT_API_URL=http://localhost:3000

# Show instance selector dropdown in production (for testing)
# Set to 'true' when deploying to Amplify for testing different backends
# VITE_SHOW_INSTANCE_SELECTOR=true

# ─── Network Configuration ─────────────────────────────────────────
# Network id to use (e.g., yellow_dot, blue_dot)
# If empty, shows network selector in sidebar for multi-network setups
VITE_NETWORK_ID=blue_dot

# ─── Credential Import Providers ────────────────────────────────────
# Dhiway Wallet configuration
# Required to enable the Dhiway wallet provider in the UI.
VITE_VC_WALLET_URL=
VITE_VC_WALLET_API_KEY=

# DigiLocker configuration
# Required to enable the DigiLocker provider in the UI.
VITE_AGENT_URL=
VITE_AGENT_TOKEN=

# DigiLocker popup callback
# The DigiLocker redirect origin should host the bridge page at:
#   /digilocker-bridge.html
# This repo includes the bridge file at docs/operations/digilocker-bridge.example.html.
VITE_ACTION_POLL_INTERVAL_MS=30000
VITE_DEFAULT_VIEW_MODE=map

# ─── Internationalization (i18n) ──────────────────────────────────
# Comma-separated list of language codes to show in the language dropdown,
# in display order. Each code must match a file in src/i18n/locales/<code>.json.
# If unset, all discovered locale files are shown (dev convenience).
# Example: VITE_ENABLED_LANGUAGES=en,kn,hi
# VITE_ENABLED_LANGUAGES=en,kn,hi

# Optional Photon endpoint for address autocomplete; free key-less fallback
# used when VITE_GOOGLE_MAPS_API_KEY is unset (default: https://photon.komoot.io)
VITE_PHOTON_URL=

# ─── Per-domain UI binding ─────────────────────────────────────────
# Scope this UI deployment to one or more comma-separated network/domain values (e.g. purple_dot/provider).
# When set: pins the network + acting domain, scopes Browse to that domain's
# interaction targets, skips the profile role-picker, hides the network
# selector, blocks cross-domain login, and adds the domain to the tab title.
# Generic — works for any "<network>/<domain>" present in network.json
# (e.g. yellow_dot/teacher). Deploy the same build as N instances, one per
# domain, against the same backend.
# Leave UNSET to serve ALL domains (the combined multi-domain UI, as before).
# In production this is supplied at runtime via config.js
# (window.__DPG_UI_CONFIG__), not baked into the build.
# VITE_SERVED_BINDINGS=purple_dot/provider                         # one entry = single-domain portal
# VITE_SERVED_BINDINGS=yellow_dot/tutor,yellow_dot/coaching_center  # multiple = whitelisted subset (same network)

# ─── Theme / build variants (also undocumented previously) ─────────
# Default network theme used for the data-network attribute on first paint.
# Falls back to the first VITE_NETWORK_ID entry, else 'blue_dot'.
# VITE_DEFAULT_NETWORK_THEME=purple_dot

# Browser tab title for the tourist build (VITE_APP=tourist). Default: OneTAC.
# VITE_TOURIST_APP_TITLE=OneTAC

# Default map view when no user/profile location (per-deployment).
# Unset = whole-India fallback. Examples: Muzaffarnagar 29.4727,77.7085 | Bengaluru 12.9716,77.5946
VITE_MAP_DEFAULT_CENTER=
VITE_MAP_DEFAULT_ZOOM=12

# ─── Brand / skin ─────────────────────────────────────────────────
# Build-time default brand skin. Runtime-overridable only via VITE_BRAND_NAME
# (chart /config.js → window.__DPG_UI_CONFIG__); NOT via a ?brand= URL param —
# brand is locked per deployment by design.
# 'standard' (or unset) = the network's brand-agnostic theme.
VITE_DEFAULT_BRAND=standard

# Page size for network-wide profile browse fetches (Signals home + orange-dots
# tourist UI). Shared by both UIs. Defaults to 1000 when unset/invalid.
VITE_PROFILE_FETCH_LIMIT=1000

# Page size for the Signals home LIST view infinite-scroll paging (#203) —
# items fetched per page as you scroll. Distinct from VITE_PROFILE_FETCH_LIMIT
# above (the legacy full-fetch cap). Defaults to 50 when unset/invalid.
VITE_PROFILE_PAGE_SIZE=50

# Max slim map markers (coords only) fetched PER DOMAIN for the MAP viewport
# when the viewport has NO bbox (radius-only callers — the list's distance
# path and the tourist app; #203 map-serverside-search Task 6). The live map
# view (bbox path) no longer uses this flat cap — see the three zoom-band cap
# vars below. Must not exceed the server markers cap (25000). Defaults to
# 25000 when unset/invalid.
# NOTE: in practice both live maps (portal + tourist) always send a bbox, so
# this flat cap governs only rare radius-only callers — it does NOT bound the
# live MAP view fetch (the zoom-band caps below do). It is build-time
# (import.meta.env), unlike those runtime caps — safe to omit from a deployment.
VITE_MAP_FETCH_LIMIT=25000

# Zoom-band marker caps for the live MAP view's bbox fetch (#203
# map-serverside-search Task 6/7), replacing VITE_MAP_FETCH_LIMIT for that
# path. The map fetches cap+1 markers so a total exactly at the cap still
# reads as complete (not truncated); above the cap the UI shows an over-dense
# "N+ in this area — zoom in" pill instead of the pins.
# All three are RUNTIME-env (getRuntimeEnv → config.js), so they can be retuned
# per deploy WITHOUT a rebuild — unlike VITE_MAP_FETCH_LIMIT above.
#   - VITE_MAP_MARKER_CAP_CLUSTERED: cap while zoomed out enough that pins
#     still cluster (below the cluster-disable zoom below). Defaults to 1000.
#   - VITE_MAP_MARKER_CAP_INDIVIDUAL: cap once zoomed in past the
#     cluster-disable zoom, where every pin renders individually (a cluster
#     icon tolerates far more density on-screen than an individual pin count
#     would). Defaults to 500.
#   - VITE_MAP_CLUSTER_DISABLE_ZOOM: the zoom level at/above which clustering
#     turns off (switches from the clustered cap to the individual cap, and
#     is also the cache-key zoom-band boundary). Defaults to 14.
VITE_MAP_MARKER_CAP_CLUSTERED=1000
VITE_MAP_MARKER_CAP_INDIVIDUAL=500
VITE_MAP_CLUSTER_DISABLE_ZOOM=14
# Smooth cluster-click zoom animation duration (ms). Runtime-env; default
# 2000, 0 = instant (no animation). Tune the fly-in feel per deploy.
VITE_MAP_CLUSTER_ZOOM_ANIM_MS=2000

# Self-signup gate (#105). 'gated' (default) blocks self-service account
# creation via the public OTP flow; onboard participants via
# POST /api/v1/admin/participant. Set 'allowed' to permit self-registration.
SELF_SIGNUP_MODE=gated

# Allowed login identifier channels, comma-separated: email / phone.
# Default both. Examples: LOGIN_CHANNELS=phone  |  LOGIN_CHANNELS=email,phone
LOGIN_CHANNELS=email,phone

# Recipient(s) for the in-app "Contact support" form (#120/#283). When unset,
# the form button is hidden and POST /api/v1/support returns 503. Sent via the
# notification service from NOTIFICATION_FROM_EMAIL; Reply-To = the submitter.
# Accepts multiple comma-separated addresses (all receive the email).
SUPPORT_EMAIL=support@example.org
# Optional CC recipient(s) for the "Contact support" form (#283). Comma-separated
# for multiple; unset => no CC header.
SUPPORT_CC_EMAIL=
# Attachment budget for the "Contact support" form (#551). Total decoded bytes
# across all files on one submission (default 5MB) and how many files may be
# attached (default 3). Served to the UI by GET /api/v1/support/config, so the
# form picks changes up without a rebuild, and the route's HTTP body limit is
# derived from the byte budget (no separate limit to keep in step).
# Raising these also needs NOTIFY_ATTACHMENT_MAX_TOTAL_BYTES /
# NOTIFY_ATTACHMENT_MAX_FILES raised on the notification service, which enforces
# its own caps. SES rejects a message over 10MB after base64 inflation, so ~7MB
# of original file is the practical ceiling whatever these say.
SUPPORT_ATTACHMENT_MAX_TOTAL_BYTES=5242880
SUPPORT_ATTACHMENT_MAX_FILES=3

{
  "name": "dpg-monorepo",
  "version": "1.0.0",
  "description": "Monorepo for DPG",
  "main": "index.js",
  "scripts": {
    "dev:api": "node scripts/turbo-with-root-env.mjs run dev --filter=api",
    "build:api": "node scripts/turbo-with-root-env.mjs run build --filter=api",
    "preview:api": "node scripts/turbo-with-root-env.mjs run preview --filter=api",
    "start:api": "node scripts/turbo-with-root-env.mjs run start --filter=api",
    "db:generate:api": "pnpm --filter api db:generate",
    "db:migrate:api": "pnpm --filter api db:migrate",
    "db:push:api": "pnpm --filter api db:push",
    "db:studio:api": "pnpm --filter api db:studio",
    "db:init:api": "pnpm --filter api db:init",
    "db:migrate:deploy:api": "pnpm --filter api db:migrate:deploy",
    "db:check:parity:api": "pnpm --filter api db:check:parity",
    "db:baseline:api": "pnpm --filter api db:baseline",
    "db:backfill:lifecycle:api": "pnpm --filter api db:backfill:lifecycle",
    "db:seed:services:api": "pnpm --filter api db:seed:services",
    "db:backfill:consent:api": "pnpm --filter api db:backfill:consent",
    "db:seed:purple_dot:api": "pnpm --filter api db:seed:purple_dot",
    "e2e:qr": "tsx scripts/e2e/submit_qr_participants.mts",
    "e2e:actions": "pnpm --filter api exec tsx scripts/e2e/seed_actions.mts",
    "dev:ui": "node scripts/turbo-with-root-env.mjs run dev --filter=ui",
    "build:ui": "node scripts/turbo-with-root-env.mjs run build --filter=ui",
    "dev:tourist": "node scripts/turbo-with-root-env.mjs run dev:tourist --filter=ui",
    "build:tourist": "node scripts/turbo-with-root-env.mjs run build:tourist --filter=ui",
    "preview:ui": "node scripts/turbo-with-root-env.mjs run preview --filter=ui",
    "docker:api": "node scripts/run-api-docker.mjs",
    "schema:bundle": "node scripts/generate-schema-bundle.mjs",
    "schema:bundle:check": "node scripts/generate-schema-bundle.mjs && git diff --exit-code apps/api/db/postgres/schema.sql",
    "typecheck": "pnpm --filter api exec tsc --noEmit && pnpm --filter ui exec tsc --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "Dhiway",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.1.2",
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  }
}

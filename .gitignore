# Dependencies
node_modules/
v10/
.codacy
.pnpm-store
# Build Outputs
dist/
build/
out/
# Drizzle migrations under apps/api/drizzle/ are COMMITTED (applied at deploy by
# the runtime migrator — see docs/operations/migrations.md). Ignore stray
# drizzle/ output elsewhere, but track the api migrations dir.
drizzle/
!apps/api/drizzle/
!apps/api/drizzle/**
.turbo/
*.tsbuildinfo
apps/*/.astro/
apps/*/.turbo/
apps/*/.vite/
apps/*/dist/
apps/ui/.turbo/
apps/ui/.vite/
apps/ui/dist/
# Environment Variables
.env
.env.*
!.env.example
!.env.*.example

# System Files
.DS_Store
Thumbs.db
data/


#Ignore cursor AI rules
.fastembed_cache
.cursor/rules/codacy.mdc

# E2E test scratch + env
scripts/e2e/.env
scripts/e2e/scratch/
.gstack/

# Test coverage reports (generated; consumed by the SonarCloud CI scan)
coverage/
.superpowers/


# Captured emails from the local mail sink (local-mail-sink/sink.mjs)
local-mail-sink/mail/

# Local-only network schemas. `examples/schemas/<network>/` is loaded by explicit
# path (NETWORK_CONFIG_LOCAL_FILE), never by scanning the directory, so a private
# scratch copy can live here — but it must not be committed. The `_` prefix is
# the convention; this makes it stick against a stray `git add -A`.
examples/schemas/_*/

# Committed, dummy-value env for `pnpm --filter api spec:dump` (apps/api/scripts/dump_openapi.ts).
# Loaded via dotenv before config parses, so the OpenAPI dump runs in CI with
# no real secrets, no database, and no Redis. NEVER put real secrets here.
#
# Kept minimal: only INSTANCE_ENV/NETWORK_CONFIG_SOURCE/API_DOMAIN/
# API_REFERENCE_* (required overrides per the docs-standardize task) plus
# every remaining no-default var that packages/config/src/secrets.ts requires
# to parse (see InstanceSecretsSchema, ApiSecretsSchema, AuthSecretsSchema,
# NetworkRuntimeSecretsSchema, DatabaseSecretsSchema, PiiCryptoSecretsSchema).
# Everything else in secrets.ts has a default or is optional.

INSTANCE_NAME=dpg-openapi-dump
INSTANCE_ENV=development
# Generic host by design: deployments are per network instance, so the
# published spec advertises a substitute-your-host URL, not one pilot's
# domain. API_PORT=443 because getCurrentApiBaseUrl() appends the port in
# development mode when the domain has none — the URL class then drops
# :443 as the https default, yielding a clean https://dpg.example.com.
API_DOMAIN=https://dpg.example.com
API_PORT=443
API_REFERENCE_ENABLED=true
API_REFERENCE_FORCE=true

AUTH_SECRET=dummy-auth-secret-for-openapi-dump

SERVED_DOMAINS=yellow_dot/student
NETWORK_CONFIG_SOURCE=local
# NETWORK_CONFIG_LOCAL_FILE left unset: its default
# (../../examples/schemas/yellow_dot/network.json, resolved from apps/api/)
# already points at a committed network.json.
INSTANCE_SHARED_SECRET=dummy-instance-shared-secret-32-bytes-minimum

# buildApp(), in NETWORK_CONFIG_SOURCE=local mode, otherwise wipes+rebuilds
# the on-disk network-schema cache at boot, which queries the real `items`
# table (see packages/config/src/secrets.ts's SCHEMA_CACHE_WARMUP_ENABLED
# comment for the full explanation). The dump has no live Postgres, and
# doesn't need one: OpenAPI route registration is fully static and never
# reads the schema cache at boot, only a request-time handler does.
SCHEMA_CACHE_WARMUP_ENABLED=false

POSTGRES_USER=dump
POSTGRES_PASSWORD=dummy-password
POSTGRES_DB=dump
REDIS_PASSWORD=dummy-password

# base64-encoded 32 dummy bytes (AES-256 key shape); never a real key.
SIGNALS_PII_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
